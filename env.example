# 이 파일을 복사해서 이름을 .env 로 바꾸고, 아래 값을 내 정보로 채워줘.
# .env 파일은 절대 Git이나 제출 파일에 넣지 않기! (.gitignore 에 .env 포함, NF2003)

# 위키미디어(위키데이터·위키백과)는 요청에 연락처를 넣으라고 요구해 (명세서 NF2006)
WIKI_CONTACT_EMAIL=your-email@example.com

# SSAFY GMS에서 발급받은 API 키
OPENAI_API_KEY=

# SSAFY GMS 안내 페이지에 적힌 OpenAI용 API 주소 (끝이 /v1 로 끝나는 주소, /chat/completions는 붙이지 않음)
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# (선택) 문화공공데이터광장에서 발급받은 '국립현대미술관_소장작품' API 서비스 키 — F2016 index_mmca.py에서만 사용
MMCA_API_KEY=
